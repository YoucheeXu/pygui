<RecordHourDialog id="dlgRecordHour" text="记录项目时间" Width="360" Height="200">
	<ImagePanel id="imgNameRecordHour" image="resources/gift.png" options="{'width':20, 'height': 20}" layout="grid" grid="{'row':0,'column':0,'sticky':'W'}"/>
    <Label id="lblItemRecordHour" text="" layout="grid" grid="{'row':0,'column':1,'sticky':'W'}"/>
	<ImagePanel id="imgScheduleRecordHour" image="resources/calendar.png" options="{'width':20, 'height': 20}" layout="grid" grid="{'row':1,'column':0,'sticky':'W'}"/>
	<Label id="lblDayRecordHour" text="日期" options="{'width':20}" layout="grid" grid="{'row':1,'column':1,'sticky':'W'}"/>
	<Label id="lblSelDayRecordHour" text="选择日期" clickable="true" options="{'width':20}" layout="grid" grid="{'row':1,'column':2}"/>
    <ImagePanel id="imgStrtRecordHour" image="resources/VaadinAlarm.png" options="{'width':20, 'height': 20}" layout="grid" grid="{'row':2,'column':0,'sticky':'W'}"/>
	<Label id="lblStrtRecordHour" text="开始时间" options="{'width':20}" layout="grid" grid="{'row':2,'column':1,'sticky':'W'}"/>
	<Label id="lblSelStrtRecordHour" text="选择开始时间" clickable="true" options="{'width':20}" layout="grid" grid="{'row':2,'column':2}"/>
	<ImagePanel id="imgLastRecordHour" image="resources/calendar_green.png" options="{'width':20, 'height': 20}" layout="grid" grid="{'row':3,'column':0,'sticky':'W'}"/>
	<Label id="lblLastRecordHour" text="持续时间" layout="grid" grid="{'row':3,'column':1,'sticky':'W'}"/>
	<Label id="lblSelLastRecordHour" text="选择持续时间" clickable="true" options="{'width':20}" layout="grid" grid="{'row':3,'column':2}"/>
</RecordHourDialog>