<CustomDialog id="dlgHourDetail" text="项目详情" Width="400" Height="550">
	<Label id="lblFatherItemDetail" text="" layout="pack" pack="{'pady':4}"/>
    <Frame id="frmItemDetail1" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}" options="{'bg':'white','columnconfigure':'(0,0,1)'}">
        <ImageButton id="btnImageHourDetail" image="resources/CircleFlagsUsBetsyRoss.png" options="{'height':40,'width':40,'bg':'white'}" layout="grid" grid="{'row':0,'column':0,'sticky':'w'}"/>
        <Label id="lblInfoHourDetail" text="" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':0,'column':1,'columnspan':2,'sticky':'w'}"/>
        <Label id="lblSumHourDetail" text="0" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':0,'column':3,'sticky':'e'}"/>
	</Frame>
	<Frame id="frmStatisticsDetail" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}" options="{'bg':'white','columnconfigure':'(1,1,1,1)'}">
        <Label id="lblWholeHourDetail" text="0" options="{'justify':'center','style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':0}"/>
        <Label id="lblAvrgHourDetail" text="0" options="{'justify':'center','style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':1}"/>
        <Label id="lblRecentHourDetail" text="0" options="{'justify':'center','style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':2}"/>
        <Label id="lblRestHourDetail" text="0" options="{'justify':'center','style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':3}"/>
    </Frame>
	<Button id="btnRecordHourDetail" text="+记录时间" options="{'width':50}" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}"/>
    <Frame id="frmItemDetail2" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}" options="{'bg':'white','columnconfigure':'(0,0,1)'}">
        <ImagePanel id="imgClockItemDetail" text="clock" image="resources/VaadinAlarm.png" options="{'width':20,'height':20,'bg':'white'}" layout="grid" grid="{'row':0,'column':0,'sticky':'w'}"/>
		<Label id="lblClockItemDetail" text="定时提醒" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':0,'column':1,'sticky':'w'}"/>
		<Label id="lblSelClockItemDetail" text="选择定时提醒" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':0,'column':2,'sticky':'e'}"/>
		<ImagePanel id="imgScheduleItemDetail" text="schedule" image="resources/calendar.png" options="{'width':20,'height': 20,'bg':'white'}" layout="grid" grid="{'row':1,'column':0,'sticky':'w'}"/>
		<Label id="lblScheduleItemDetail" text="时间投入计划" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':1,'sticky':'w'}"/>
		<Label id="lblSelScheduleItemDetail" text="选择时间投入计划" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':1,'column':2,'sticky':'e'}"/>
    </Frame>
    <Frame id="frmAddChild" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}" options="{'bg':'white','columnconfigure':'(0,0,1)'}">
        <ImagePanel id="imgChildren" image="resources/gift.png" options="{'height':20,'width':20,'bg':'white'}" layout="grid" grid="{'row':0,'column':0}"/>
        <Label id="lblTotalChildren" text="共0个子项目" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':0,'column':1,'sticky':'w'}"/>
        <Button id="btnAddChild" text="+添加" options="{'width':10}" layout="grid" grid="{'row':0,'column':2,'sticky':'e'}"/>
    </Frame>
    <Frame id="frmSubItmes" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}"/>
	<Notebook id="ntbStatisticsHour" layout="pack" pack="{'padx':12,'pady':4,'fill':'x','expand':1}">
    	<Tab id="tabEveryDayHour" text="每日投入" options="{'bg':'white'}">
			<ImageButton id="btnPrevDayHour" image="resources/left-arrow.png" options="{'height':20,'width':20,'bg':'white'}" layout="grid" grid="{'row':0,'column':0}"/>
    		<ImageButton id="btnPrevWeekHour" image="resources/previous.png" options="{'height':20,'width':20,'bg':'white'}" layout="grid" grid="{'row':1,'column':0}"/>
            <MatPlot id="pltEveryDayHour" text="" size="(394,220)" xLabel="" yLabel="" layout="grid" grid="{'row':0,'column':1,'rowspan':2}"/>
            <ImageButton id="btnNextDayHour" image="resources/right-arrow.png" options="{'height':20,'width':20,'bg':'white'}" layout="grid" grid="{'row':0,'column':2}"/>
            <ImageButton id="btnNextWeekHour" image="resources/next.png" options="{'height':20,'width':20,'bg':'white'}" layout="grid" grid="{'row':1,'column':2}"/>
    		<Label id="lblDaySum" text="今日共投入0小时" options="{'style':'BW.TLabel'}" layout="grid" grid="{'row':2,'column':0,'columnspan':3}"/>
			<Canvas id="cvsDetailEveryDayHour" layout="grid" grid="{'row':3,'column':0,'columnspan':3}"/>
		</Tab>
		<Tab id="tabEveryWeekHour" text="每周投入">
			<Label id="lblWeekSum" text="本周共投入0小时" options="{'width':20}" layout="pack" pack="{'pady':4}"/>
		</Tab>
		<Tab id="tabEveryMonthHour" text="每月投入">
			<Label id="lblMonthSum" text="本月共投入0小时" options="{'width':20}" layout="pack" pack="{'pady':4}"/>
		</Tab>
		<Tab id="tabEveryYearHour" text="每年投入">
			<Label id="lblYearSum" text="本年共投入0小时" options="{'width':20}" layout="pack" pack="{'pady':4}"/>
		</Tab>
	</Notebook>
</CustomDialog>